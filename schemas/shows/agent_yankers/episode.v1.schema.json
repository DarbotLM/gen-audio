{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/shows/agent_yankers/episode.v1.schema.json",
  "title": "AgentYankersEpisode",
  "description": "Episode or highlight reel for genaid to stitch. Walk segments in order. Concatenate only status rendered. Leave status planned out of the mix. The document carries no credentials and no audio bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "show",
    "kind",
    "id",
    "title",
    "premise_id",
    "sample_rate",
    "channels",
    "consumer",
    "highlights",
    "segments"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "show": { "const": "agent_yankers" },
    "kind": { "enum": ["episode", "highlight_reel"] },
    "id": { "type": "string", "pattern": "^ay-[a-z0-9-]{1,48}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "premise_id": { "type": "string", "pattern": "^premise-[a-z0-9-]{1,48}$" },
    "sample_rate": { "const": 24000 },
    "channels": { "const": 1 },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract", "order", "rules"],
      "properties": {
        "name": { "const": "genaid" },
        "contract": {
          "const": "https://darbotlabs.dev/gen-audio/shows/agent_yankers/episode.v1.schema.json"
        },
        "order": { "const": "segments" },
        "rules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 8, "maxLength": 240 }
        }
      }
    },
    "highlights": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "segment_id", "call_segment_id", "mark_id", "in_s", "out_s", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^hl-[a-z0-9-]{1,48}$" },
          "segment_id": { "type": "string", "pattern": "^hl-[a-z0-9-]{1,48}$" },
          "call_segment_id": { "type": "string", "pattern": "^call-mark-[a-z0-9-]{1,48}$" },
          "mark_id": { "type": "string", "pattern": "^mark-[a-z0-9-]{1,48}$" },
          "in_s": { "type": "number", "minimum": 0 },
          "out_s": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string", "minLength": 8, "maxLength": 300 }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "status", "source", "asset"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,80}$" },
          "role": { "enum": ["host", "laughter", "stinger", "call", "highlight"] },
          "status": { "enum": ["planned", "rendered"] },
          "source": { "enum": ["vibevoice", "sfx", "livekit"] },
          "asset": {
            "type": ["string", "null"],
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,40}/){0,4}[A-Za-z0-9][A-Za-z0-9_-]{0,48}\\.wav$"
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "voice_stem": {
            "type": "string",
            "pattern": "^[a-z]{2,3}-[A-Za-z0-9]+_(man|woman|neutral)(_bgm)?$"
          },
          "sfx_id": { "enum": ["crowd-laugh-short", "crowd-laugh-long", "stinger-open", "stinger-button"] },
          "mark_id": { "type": "string", "pattern": "^mark-[a-z0-9-]{1,48}$" },
          "is_agent": { "type": "boolean" },
          "consent_record_ref": {
            "type": "string",
            "pattern": "^consent/[A-Za-z0-9][A-Za-z0-9._-]{0,64}\\.txt$"
          },
          "premise_id": { "type": "string", "pattern": "^premise-[a-z0-9-]{1,48}$" },
          "call_segment_id": { "type": "string", "pattern": "^call-mark-[a-z0-9-]{1,48}$" },
          "in_s": { "type": "number", "minimum": 0 },
          "out_s": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string", "minLength": 8, "maxLength": 300 }
        }
      }
    }
  }
}
