{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/shows/agent_yankers/highlights.v1.schema.json",
  "title": "AgentYankersHighlights",
  "description": "Edit picks for one premise. in_s and out_s are seconds into the call. The episode manifest copies these onto highlight segments after the consent check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "show", "highlights"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "show": { "const": "agent_yankers" },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mark_id", "in_s", "out_s", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^hl-[a-z0-9-]{1,48}$" },
          "mark_id": { "type": "string", "pattern": "^mark-[a-z0-9-]{1,48}$" },
          "in_s": { "type": "number", "minimum": 0 },
          "out_s": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string", "minLength": 8, "maxLength": 300 }
        }
      }
    }
  }
}
