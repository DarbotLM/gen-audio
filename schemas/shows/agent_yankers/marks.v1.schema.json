{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/shows/agent_yankers/marks.v1.schema.json",
  "title": "AgentYankersMarks",
  "description": "Index of call targets. Every mark has is_agent and an explicit consent object. The call runner still refuses a mark unless that consent is recorded for both the caller and the mark. is_agent does not waive consent. endpoint.kind is livekit_agent so this index does not store phone numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "show", "marks"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "show": { "const": "agent_yankers" },
    "marks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "is_agent", "endpoint", "consent", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^mark-[a-z0-9-]{1,48}$" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "is_agent": {
            "type": "boolean",
            "description": "True when the mark is itself an agent. False is a person. Both still require recorded consent."
          },
          "endpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity"],
            "properties": {
              "kind": { "const": "livekit_agent" },
              "identity": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
            }
          },
          "consent": {
            "type": "object",
            "additionalProperties": false,
            "description": "Explicit opt-in. recorded, recorded_at, method, record_ref, and both parties must all be set before the runner will call this mark.",
            "required": ["opt_in", "recorded", "recorded_at", "method", "record_ref", "parties", "statement"],
            "properties": {
              "opt_in": { "type": "boolean" },
              "recorded": { "type": "boolean" },
              "recorded_at": {
                "type": ["string", "null"],
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "method": { "enum": ["written", "recorded_verbal", null] },
              "record_ref": {
                "type": ["string", "null"],
                "pattern": "^consent/[A-Za-z0-9][A-Za-z0-9._-]{0,64}\\.txt$"
              },
              "parties": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "enum": ["caller", "mark"] }
              },
              "statement": { "type": "string", "minLength": 8, "maxLength": 500 }
            }
          },
          "notes": { "type": "string", "minLength": 8, "maxLength": 300 }
        }
      }
    }
  }
}
