{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/shows/agent_yankers/voiceover.v1.schema.json",
  "title": "AgentYankersVoiceover",
  "description": "Show-layer cues. Host lines name a VibeVoice reference stem. Laughter and stingers name an SFX id. model_env and sfx_dir_env are environment variable names, not paths and not secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "show", "engine", "model_env", "sfx_dir_env", "host_voice", "cues"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "show": { "const": "agent_yankers" },
    "engine": { "const": "vibevoice" },
    "model_env": { "const": "GEN_AUDIO_VIBEVOICE_MODEL" },
    "sfx_dir_env": { "const": "GEN_AUDIO_AGENT_YANKERS_SFX_DIR" },
    "host_voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_stem", "file_prefix", "background_music"],
      "properties": {
        "file_stem": {
          "type": "string",
          "pattern": "^[a-z]{2,3}-[A-Za-z0-9]+_(man|woman|neutral)(_bgm)?$"
        },
        "file_prefix": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "background_music": { "type": "boolean" }
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "placement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,80}$" },
          "role": { "enum": ["host", "laughter", "stinger"] },
          "placement": {
            "enum": ["open", "after_call", "close"],
            "description": "open plays before the calls, after_call plays once after each consented call, close plays after the last call."
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sfx_id": { "enum": ["crowd-laugh-short", "crowd-laugh-long", "stinger-open", "stinger-button"] }
        }
      }
    }
  }
}
